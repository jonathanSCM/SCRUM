generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  LEAD
  MEMBER
}

// IMPORTANTE (producción): el contenedor corre `prisma db push --accept-data-loss`
// en cada arranque, así que cualquier columna/tabla que se borre acá se pierde
// sin aviso. Todo cambio de esquema tiene que ser ADITIVO (columnas nuevas con
// default o nullable); los datos viejos se convierten por código idempotente en
// prisma/seed.ts (ver prisma/legacy-migrate.ts). Las columnas marcadas "legacy"
// ya no las usa la app pero se conservan hasta una release de limpieza.

model User {
  id                  String    @id @default(cuid())
  name                String
  email               String    @unique
  passwordHash        String
  role                Role      @default(MEMBER)
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  createdAt           DateTime  @default(now())
  discordUserId       String?
  chatColor           String? // color propio en el chat (#RRGGBB)
  tagline             String? // frase corta del perfil público
  telegramUsername    String?
  slackUserId         String?

  passwordResetTokens PasswordResetToken[]
  assignedIssues      Task[]               @relation("TaskAssignee")
  reportedIssues      Task[]               @relation("TaskReporter")
  ledProjects         Project[]            @relation("ProjectLead")
  comments            Comment[]
  attachments         Attachment[]
  notes               Note[]
  messages            ProjectMessage[]
  standups            StandupEntry[]
  retroItems          RetroItem[]
  pushSubscriptions   PushSubscription[]
  chatMessages        ChatMessage[]
  chatReactions       ChatReaction[]
  apiTokens           ApiToken[]
  images              UserImage[]
  memberships         Membership[]
  invitationsSent     Invitation[]
  resourcesUploaded   ProjectResource[] @relation("ResourceUploader")
  projectMemberships  ProjectMember[]   @relation("ProjectMemberUser")
  involvedIn          TaskInvolved[]    @relation("TaskInvolvedUser")
  fileCardsCreated    FileCard[]        @relation("FileCardCreator")
  ntfyChannel         NtfyChannel?      @relation("NtfyChannelUser")
  notifications       Notification[]    @relation("NotificationUser")
  notifPrefs          NotifPrefs?       @relation("NotifPrefsUser")
  chatReads           ChatRead[]        @relation("ChatReadUser")
  chatChannelMembers  ChatChannelMember[] @relation("ChatChannelMemberUser")
  fileCardItemsUploaded FileCardItem[]  @relation("FileCardItemUploader")
  apiTokenLogs        ApiTokenLog[]
  chatFiles           ChatFile[]
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Estado del PROYECTO (columnas del tablero de portafolio). No confundir con
// el estado de un ticket (Task.status: TODO / IN_PROGRESS / IN_REVIEW / DONE).
model StatusOption {
  id    String @id @default(cuid())
  name  String
  color String
  order Int    @default(0)

  workspaceId String?
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  projects Project[]
}

model Project {
  id          String   @id @default(cuid())
  key         String? // único dentro de cada equipo: @@unique([workspaceId, key])
  name        String
  description String   @default("")
  repoUrl     String?
  deployUrl   String?
  language    String?
  stack       String   @default("[]")
  feedDigestMinutes Int @default(30) // los avisos a Discord/Telegram/Slack van juntos cada X minutos (0 = al instante)
  feedItems   ProjectFeedItem[]
  labels      String   @default("[]") // etiquetas del proyecto (ej. "Producto"), JSON de strings
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
  taskSeq     Int      @default(0)

  discordWebhookUrl String?

  // Telegram: token del bot (secreto, nunca se devuelve por la API) y chat/grupo destino.
  telegramBotToken String?
  telegramChatId   String?

  // Slack: Incoming Webhook (secreto, nunca se devuelve completo por la API).
  slackWebhookUrl String?
  slackChannelId  String? // para subir archivos (PDF del sprint) con el bot de Slack

  // Definition of Ready: JSON con los textos que un ticket debe cubrir antes de empezar.
  readyItems String @default("[]")

  workspaceId String?
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  statusId String
  status   StatusOption @relation(fields: [statusId], references: [id])

  // legacy: ids/nombres del panel viejo. Reemplazado por leadUserId.
  assigneeId   String?
  assigneeName String?

  leadUserId String?
  lead       User?   @relation("ProjectLead", fields: [leadUserId], references: [id], onDelete: SetNull)

  tasks       Task[]
  sprints     Sprint[]
  documents   Document[]
  attachments Attachment[]
  resources   ProjectResource[]
  members     ProjectMember[]
  fileCards   FileCard[]
  chatChannel ChatChannel?
  history     HistoryEntry[]
  notes       Note[]
  messages    ProjectMessage[]
  chatRefs    ChatRef[]
  standups    StandupEntry[]
  retroItems  RetroItem[]
  contacts    ProjectContact[]

  @@unique([workspaceId, key])
  @@index([workspaceId])
}

// Sin uso desde la v2 (solo guardaba metadatos). Se reemplaza por Attachment.
model Document {
  id         String   @id @default(cuid())
  filename   String
  fileType   String
  docType    String
  uploadedAt DateTime @default(now())

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model HistoryEntry {
  id            String   @id @default(cuid())
  field         String
  oldValue      String?
  newValue      String?
  changedAt     DateTime @default(now())
  changedByName String?
  changedById   String?
  taskTitle     String?
  taskId        String?

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, changedAt])
}

// Un "ticket" de Jira: Épica, Historia, Tarea o Bug.
model Task {
  id          String @id @default(cuid())
  number      Int?
  title       String
  description String @default("")

  // legacy: antes era el falso estado (CAMBIO_*). Reemplazado por status/issueType.
  type String @default("")

  issueType   String  @default("TASK") // EPIC | STORY | TASK | BUG
  status      String  @default("TODO") // TODO | IN_PROGRESS | IN_REVIEW | DONE
  priority    String  @default("MEDIA") // URGENTE | ALTA | MEDIA | BAJA
  storyPoints Int?
  labels      String  @default("[]")
  checklist   String  @default("[]") // [{ id, text, done }] dentro de la tarjeta
  readyDone   String  @default("[]") // ítems de la Definition of Ready ya cubiertos
  rank        Float   @default(0)
  epicColor   String?

  dueDate       DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now()) @updatedAt
  completedAt   DateTime?
  sprintAddedAt DateTime?

  // legacy: ids/nombres del panel viejo. Reemplazado por assigneeUserId.
  assigneeId   String?
  assigneeName String?
  moduleName   String?

  assigneeUserId String?
  assignee       User?   @relation("TaskAssignee", fields: [assigneeUserId], references: [id], onDelete: SetNull)
  reporterId     String?
  reporter       User?   @relation("TaskReporter", fields: [reporterId], references: [id], onDelete: SetNull)

  epicId   String?
  epic     Task?   @relation("EpicChildren", fields: [epicId], references: [id], onDelete: SetNull)
  children Task[]  @relation("EpicChildren")

  // Historia > tarea/bug (la épica sigue en epicId).
  parentId String?
  parent   Task?   @relation("StoryChildren", fields: [parentId], references: [id], onDelete: SetNull)
  subtasks Task[]  @relation("StoryChildren")

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  sprintId String?
  sprint   Sprint? @relation(fields: [sprintId], references: [id], onDelete: SetNull)

  comments    Comment[]
  attachments Attachment[]
  resources   ProjectResource[]
  involved    TaskInvolved[]

  @@unique([projectId, number])
  @@index([projectId, sprintId])
}

model Sprint {
  id        String    @id @default(cuid())
  name      String
  goal      String    @default("")
  startDate DateTime?
  endDate   DateTime?
  createdAt DateTime  @default(now())

  state       String    @default("PLANNED") // PLANNED | ACTIVE | COMPLETED
  startedAt   DateTime?
  completedAt DateTime?

  committedPoints Int @default(0)
  committedCount  Int @default(0)
  completedPoints Int @default(0)
  completedCount  Int @default(0)

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  tasks      Task[]
  retroItems RetroItem[]
  resources  ProjectResource[]

  @@index([projectId, state])
}

model Comment {
  id        String   @id @default(cuid())
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  authorId String?
  author   User?   @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([taskId, createdAt])
}

model Attachment {
  id        String   @id @default(cuid())
  filename  String
  mimeType  String
  size      Int
  data      Bytes
  createdAt DateTime @default(now())

  taskId String?
  task   Task?   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  uploadedById String?
  uploadedBy   User?   @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
}

// Notas públicas del proyecto (brief, actas de reunión, acuerdos). Las ve y
// las edita todo el equipo.
model Note {
  id        String   @id @default(cuid())
  title     String
  body      String   @default("")
  kind      String   @default("GENERAL") // BRIEF | REUNION | GENERAL
  pinned    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  authorId String?
  author   User?   @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([projectId, updatedAt])
}

// Chat por proyecto (v anterior). Ya no se usa: sus mensajes se copian al chat
// general (ChatMessage.legacyId) y la tabla se conserva hasta una release de limpieza.
model ProjectMessage {
  id        String   @id @default(cuid())
  body      String
  createdAt DateTime @default(now())

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  authorId String?
  author   User?   @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([projectId, createdAt])
}

// Daily asíncrono: una entrada por persona y día (fecha "YYYY-MM-DD").
model StandupEntry {
  id        String   @id @default(cuid())
  date      String
  yesterday String   @default("")
  today     String   @default("")
  blockers  String   @default("")
  help      String   @default("") // "¿en qué te puedo ayudar?"
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId, date])
  @@index([projectId, date])
}

// Retro de un sprint: qué funcionó, qué mejorar y acuerdos (que pueden pasar a ticket).
model RetroItem {
  id        String   @id @default(cuid())
  column    String // WENT_WELL | IMPROVE | ACTION
  body      String
  ticketKey String? // si el acuerdo ya se convirtió en ticket
  createdAt DateTime @default(now())

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  sprintId String
  sprint   Sprint @relation(fields: [sprintId], references: [id], onDelete: Cascade)

  authorId String?
  author   User?   @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([projectId, sprintId])
}

// Ayuda y contactos: quién sabe de qué / a quién llamar en cada proyecto.
model ProjectContact {
  id        String   @id @default(cuid())
  name      String
  role      String   @default("")
  contact   String   @default("")
  notes     String   @default("")
  createdAt DateTime @default(now())

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

// Suscripción de un navegador/dispositivo a las notificaciones push (PWA).
model PushSubscription {
  id        String   @id @default(cuid())
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Chat general del equipo. El texto lleva marcas [[project:id]] / [[issue:id]] /
// [[sprint:id]] / [[user:id]] que se muestran como chapitas con enlace.
model ChatMessage {
  id          String     @id @default(cuid())
  workspaceId String?
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  body        String
  channelId   String? // null = mensajes anteriores a los canales: cuentan como "General"
  channel     ChatChannel? @relation(fields: [channelId], references: [id], onDelete: SetNull)
  announce    Boolean    @default(false) // aviso enviado por comando (/noti, /reunion, /urgente, /ayuda)
  level       String? // null = normal | "AYUDA" | "URGENTE" (avisos por comando; se resaltan en el chat)
  legacyId    String?    @unique // id del ProjectMessage del que se copió
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @default(now()) @updatedAt // cambia con reacciones y borrados (el chat se sincroniza por acá)
  deletedAt   DateTime? // legacy: versión anterior hacía borrado suave; ahora se borra de verdad (ver ChatDeletion)

  // Respuesta a otro mensaje
  replyToId String?
  replyTo   ChatMessage?  @relation("ChatReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies   ChatMessage[] @relation("ChatReplies")

  authorId String?
  author   User?   @relation(fields: [authorId], references: [id], onDelete: SetNull)

  refs      ChatRef[]
  files     ChatFile[]
  reactions ChatReaction[]

  @@index([createdAt])
  @@index([updatedAt])
}

// Canal del chat del equipo. Cada equipo tiene "General" (GENERAL) y "Reuniones" (REUNIONES); los líderes crean más (CUSTOM).
model ChatChannel {
  id          String   @id @default(cuid())
  name        String
  slug        String
  kind        String   @default("CUSTOM")
  createdAt   DateTime @default(now())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  messages    ChatMessage[]
  reads       ChatRead[]
  // Canales privados (PRIVATE) y mensajes directos (DIRECT): solo ven y escriben sus miembros.
  members     ChatChannelMember[]

  // Canal de un proyecto (kind PROJECT): uno por proyecto, se crea solo y desaparece con el proyecto.
  projectId String?  @unique
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, slug])
}

model ChatChannelMember {
  id        String      @id @default(cuid())
  createdAt DateTime    @default(now())
  channelId String
  channel   ChatChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  userId    String
  user      User        @relation("ChatChannelMemberUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([channelId, userId])
  @@index([userId])
}

// Hasta cuándo leyó cada persona cada canal (para los mensajes sin leer de la lista de canales).
model ChatRead {
  id         String   @id @default(cuid())
  lastReadAt DateTime @default(now())

  userId    String
  user      User        @relation("ChatReadUser", fields: [userId], references: [id], onDelete: Cascade)
  channelId String
  channel   ChatChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([userId, channelId])
}

// Referencia dentro de un mensaje. projectId permite filtrar el chat por proyecto.
model ChatRef {
  id       String @id @default(cuid())
  kind     String // PROJECT | ISSUE | SPRINT | USER
  targetId String

  messageId String
  message   ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@index([projectId])
}

// Archivo adjunto de un mensaje del chat. Hoy vive en la base (ver src/lib/fileStore.ts).
model ChatFile {
  id          String   @id @default(cuid())
  workspaceId String?
  filename    String
  mimeType    String
  size        Int
  data        Bytes
  createdAt   DateTime @default(now())

  messageId String?
  message   ChatMessage? @relation(fields: [messageId], references: [id], onDelete: Cascade)

  uploadedById String?
  uploadedBy   User?   @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([messageId])
}

// Reacción con emoji a un mensaje (una por persona y emoji).
model ChatReaction {
  id        String   @id @default(cuid())
  emoji     String
  createdAt DateTime @default(now())

  messageId String
  message   ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
}

// Lápida de un mensaje borrado: sirve solo para avisar a los demás navegadores
// que lo quiten de la pantalla en su próximo refresco (se limpia a los pocos días).
model ChatDeletion {
  workspaceId String?
  messageId   String   @id
  deletedAt   DateTime @default(now())

  @@index([deletedAt])
}

// Token personal para que un asistente (Claude) use la API en nombre de la persona.
// Solo se guarda el hash: el token se muestra una vez al crearlo. Hay uno por usuario.
model ApiToken {
  id          String    @id @default(cuid())
  workspaceId String? // el token solo actúa dentro de este equipo
  tokenHash   String    @unique
  prefix      String // primeros caracteres, solo para reconocerlo en pantalla
  createdAt   DateTime  @default(now())
  lastUsedAt  DateTime?
  allowDelete Boolean   @default(false) // opcional: permite borrar tickets, notas y comentarios
  name        String    @default("Token") // nombre que le pone su dueño (ej. "Claude", "ChatGPT")
  tokenEnc    String? // el token cifrado, para poder volver a copiarlo (los anteriores a este cambio no lo tienen)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Registro PRIVADO de lo que se hizo con el token (solo lo ve su dueño en Mi perfil;
// no aparece en el historial de los proyectos).
model ApiTokenLog {
  id        String   @id @default(cuid())
  route     String // "POST /api/projects/xyz/issues"
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// Foto de perfil y banner (ya reducidos y recodificados a WebP). Una fila por tipo.
model UserImage {
  id        String   @id @default(cuid())
  kind      String // AVATAR | BANNER
  mimeType  String
  data      Bytes
  updatedAt DateTime @default(now()) @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, kind])
}

// ---- Multi-equipo ----

// Un equipo (espacio de trabajo). Todo lo que se crea vive dentro de uno.
model Workspace {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())

  // Integraciones del equipo. Las claves se guardan cifradas (AES-256-GCM); el "hint" son los últimos 4 caracteres.
  geminiKeyEnc  String?
  geminiKeyHint String?
  slackBotEnc   String?
  slackBotHint  String?
  // Webhook de Slack del equipo (para /noti y avisos generales, independiente del de cada proyecto).
  slackWebhookEnc  String?
  slackWebhookHint String?

  members     Membership[]
  projects    Project[]
  statuses    StatusOption[]
  chat        ChatMessage[]
  channels    ChatChannel[]
  fileCards   FileCard[]
  invitations Invitation[]
}

// Pertenencia de una cuenta a un equipo, con su rol allí: OWNER | ADMIN | MEMBER.
// Una cuenta puede estar en varios equipos con roles distintos.
model Membership {
  id        String   @id @default(cuid())
  role      String   @default("MEMBER")
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
  @@index([workspaceId])
}

// Invitación a un equipo, ligada a un email. Solo se guarda el hash del enlace; vence y sirve una sola vez.
model Invitation {
  id         String    @id @default(cuid())
  email      String
  role       String    @default("MEMBER") // ADMIN | MEMBER
  tokenHash  String    @unique
  createdAt  DateTime  @default(now())
  expiresAt  DateTime
  acceptedAt DateTime?
  revokedAt  DateTime?

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  invitedById String?
  invitedBy   User?   @relation(fields: [invitedById], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([email])
}

// Archivos y enlaces del proyecto ("Archivos"), con etiquetas. Pueden pertenecer al proyecto, a un sprint o a un ticket.
// Los archivos se guardan en la base (como los adjuntos); más adelante pasarán a almacenamiento S3.
model ProjectResource {
  id        String   @id @default(cuid())
  kind      String // FILE | LINK
  title     String
  url       String? // solo LINK
  filename  String? // solo FILE
  mimeType  String?
  size      Int?
  data      Bytes?
  tags      String   @default("[]") // JSON de strings
  createdAt DateTime @default(now())

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sprintId  String?
  sprint    Sprint?  @relation(fields: [sprintId], references: [id], onDelete: SetNull)
  taskId    String?
  task      Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)
  uploadedById String?
  uploadedBy   User?   @relation("ResourceUploader", fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([projectId, createdAt])
}

// Personas del equipo asignadas a un proyecto (se les avisa al agregarlas).
model ProjectMember {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User    @relation("ProjectMemberUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
}

// Involucrados de un ticket (además del responsable): reciben aviso de comentarios y menciones.
model TaskInvolved {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId String
  user   User   @relation("TaskInvolvedUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([taskId, userId])
}

// Biblioteca del equipo: tarjetas que agrupan varios archivos y enlaces (por ejemplo "Resolución de la reunión del 5 de nov").
// Pertenecen al equipo y, si se quiere, a un proyecto. Los archivos se guardan en la base (como los adjuntos).
model FileCard {
  id          String   @id @default(cuid())
  title       String
  description String   @default("")
  category    String   @default("OTRO") // RESOLUCION_REUNION | ACTA | CONTRATO | ENTREGABLE | REFERENCIA | OTRO
  tags        String   @default("[]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  projectId   String?
  project     Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdById String?
  createdBy   User?     @relation("FileCardCreator", fields: [createdById], references: [id], onDelete: SetNull)

  items FileCardItem[]

  @@index([workspaceId, createdAt])
}

model FileCardItem {
  id        String   @id @default(cuid())
  kind      String // FILE | LINK
  title     String
  url       String?
  filename  String?
  mimeType  String?
  size      Int?
  data      Bytes?
  note      String   @default("") // mini nota del archivo (ej. "versión firmada")
  createdAt DateTime @default(now())

  cardId String
  card   FileCard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  uploadedById String?
  uploadedBy   User?   @relation("FileCardItemUploader", fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([cardId])
}

// Canal de avisos al teléfono con la app ntfy (Android / iOS). Una persona = un tema secreto.
model NtfyChannel {
  id        String    @id @default(cuid())
  topic     String    @unique // aleatorio e imposible de adivinar: quien lo sabe puede leer los avisos
  enabled   Boolean   @default(true)
  minimal   Boolean   @default(true) // true: avisa sin el texto del mensaje (solo "te mencionaron en SAI-12")
  failures  Int       @default(0) // fallos seguidos; a los 3 se desactiva solo
  lastOkAt  DateTime?
  lastError String?
  createdAt DateTime  @default(now())

  userId String @unique
  user   User   @relation("NtfyChannelUser", fields: [userId], references: [id], onDelete: Cascade)
}

// Bandeja de avisos de cada persona. Todo aviso queda aquí; además puede llegar al navegador o al teléfono al instante
// (instante), agrupado en un resumen (pendiente hasta deliverAfter) o no avisar (silencio).
model Notification {
  id           String    @id @default(cuid())
  kind         String // MENTION | ASSIGNED | COMMENT … (ver src/lib/scrum/notifPolicy.ts)
  title        String
  body         String    @default("")
  url          String?
  priority     String    @default("default") // low | default | high | urgent
  groupKey     String? // los pendientes con la misma clave se juntan (ej. todos los cambios de SAI-12)
  count        Int       @default(1)
  createdAt    DateTime  @default(now())
  deliverAfter DateTime? // cuándo sale en un resumen (null: no espera)
  deliveredAt  DateTime? // null = pendiente de resumen
  pushed       Boolean   @default(false) // se mandó al navegador / teléfono
  readAt       DateTime?
  workspaceId  String?

  userId String
  user   User   @relation("NotificationUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([deliveredAt, deliverAfter])
}

// Preferencias de avisos de cada persona.
model NotifPrefs {
  id            String  @id @default(cuid())
  digestMinutes Int     @default(30) // 0 = sin resumen (solo bandeja)
  quietEnabled  Boolean @default(false)
  quietStart    String  @default("22:00")
  quietEnd      String  @default("07:00")
  tz            String  @default("America/La_Paz")
  muted         String  @default("[]") // categorías silenciadas: tickets | assignments | team | sprints

  userId String @unique
  user   User   @relation("NotifPrefsUser", fields: [userId], references: [id], onDelete: Cascade)
}

// Avisos de proyecto que esperan para ir juntos, en un solo mensaje, a Discord / Telegram / Slack.
model ProjectFeedItem {
  id          String    @id @default(cuid())
  kind        String
  title       String
  description String    @default("")
  url         String?
  createdAt   DateTime  @default(now())
  sentAt      DateTime?

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, sentAt])
}
