generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  LEAD
  MEMBER
}

// IMPORTANTE (producción): el contenedor corre `prisma db push --accept-data-loss`
// en cada arranque, así que cualquier columna/tabla que se borre acá se pierde
// sin aviso. Todo cambio de esquema tiene que ser ADITIVO (columnas nuevas con
// default o nullable); los datos viejos se convierten por código idempotente en
// prisma/seed.ts (ver prisma/legacy-migrate.ts). Las columnas marcadas "legacy"
// ya no las usa la app pero se conservan hasta una release de limpieza.

model User {
  id                  String    @id @default(cuid())
  name                String
  email               String    @unique
  passwordHash        String
  role                Role      @default(MEMBER)
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  createdAt           DateTime  @default(now())
  discordUserId       String?
  chatColor           String? // color propio en el chat (#RRGGBB)
  telegramUsername    String?
  slackUserId         String?

  passwordResetTokens PasswordResetToken[]
  assignedIssues      Task[]               @relation("TaskAssignee")
  reportedIssues      Task[]               @relation("TaskReporter")
  ledProjects         Project[]            @relation("ProjectLead")
  comments            Comment[]
  attachments         Attachment[]
  notes               Note[]
  messages            ProjectMessage[]
  standups            StandupEntry[]
  retroItems          RetroItem[]
  pushSubscriptions   PushSubscription[]
  chatMessages        ChatMessage[]
  chatReactions       ChatReaction[]
  chatFiles           ChatFile[]
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Estado del PROYECTO (columnas del tablero de portafolio). No confundir con
// el estado de un ticket (Task.status: TODO / IN_PROGRESS / IN_REVIEW / DONE).
model StatusOption {
  id    String @id @default(cuid())
  name  String
  color String
  order Int    @default(0)

  projects Project[]
}

model Project {
  id          String   @id @default(cuid())
  key         String?  @unique
  name        String
  description String   @default("")
  repoUrl     String?
  deployUrl   String?
  language    String?
  stack       String   @default("[]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
  taskSeq     Int      @default(0)

  discordWebhookUrl String?

  // Telegram: token del bot (secreto, nunca se devuelve por la API) y chat/grupo destino.
  telegramBotToken String?
  telegramChatId   String?

  // Slack: Incoming Webhook (secreto, nunca se devuelve completo por la API).
  slackWebhookUrl String?
  slackChannelId  String? // para subir archivos (PDF del sprint) con el bot de Slack

  // Definition of Ready: JSON con los textos que un ticket debe cubrir antes de empezar.
  readyItems String @default("[]")

  statusId String
  status   StatusOption @relation(fields: [statusId], references: [id])

  // legacy: ids/nombres del panel viejo. Reemplazado por leadUserId.
  assigneeId   String?
  assigneeName String?

  leadUserId String?
  lead       User?   @relation("ProjectLead", fields: [leadUserId], references: [id], onDelete: SetNull)

  tasks       Task[]
  sprints     Sprint[]
  documents   Document[]
  attachments Attachment[]
  history     HistoryEntry[]
  notes       Note[]
  messages    ProjectMessage[]
  chatRefs    ChatRef[]
  standups    StandupEntry[]
  retroItems  RetroItem[]
  contacts    ProjectContact[]
}

// Sin uso desde la v2 (solo guardaba metadatos). Se reemplaza por Attachment.
model Document {
  id         String   @id @default(cuid())
  filename   String
  fileType   String
  docType    String
  uploadedAt DateTime @default(now())

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model HistoryEntry {
  id            String   @id @default(cuid())
  field         String
  oldValue      String?
  newValue      String?
  changedAt     DateTime @default(now())
  changedByName String?
  changedById   String?
  taskTitle     String?
  taskId        String?

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, changedAt])
}

// Un "ticket" de Jira: Épica, Historia, Tarea o Bug.
model Task {
  id          String @id @default(cuid())
  number      Int?
  title       String
  description String @default("")

  // legacy: antes era el falso estado (CAMBIO_*). Reemplazado por status/issueType.
  type String @default("")

  issueType   String  @default("TASK") // EPIC | STORY | TASK | BUG
  status      String  @default("TODO") // TODO | IN_PROGRESS | IN_REVIEW | DONE
  priority    String  @default("MEDIA") // URGENTE | ALTA | MEDIA | BAJA
  storyPoints Int?
  labels      String  @default("[]")
  checklist   String  @default("[]") // [{ id, text, done }] dentro de la tarjeta
  readyDone   String  @default("[]") // ítems de la Definition of Ready ya cubiertos
  rank        Float   @default(0)
  epicColor   String?

  dueDate       DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now()) @updatedAt
  completedAt   DateTime?
  sprintAddedAt DateTime?

  // legacy: ids/nombres del panel viejo. Reemplazado por assigneeUserId.
  assigneeId   String?
  assigneeName String?
  moduleName   String?

  assigneeUserId String?
  assignee       User?   @relation("TaskAssignee", fields: [assigneeUserId], references: [id], onDelete: SetNull)
  reporterId     String?
  reporter       User?   @relation("TaskReporter", fields: [reporterId], references: [id], onDelete: SetNull)

  epicId   String?
  epic     Task?   @relation("EpicChildren", fields: [epicId], references: [id], onDelete: SetNull)
  children Task[]  @relation("EpicChildren")

  // Historia > tarea/bug (la épica sigue en epicId).
  parentId String?
  parent   Task?   @relation("StoryChildren", fields: [parentId], references: [id], onDelete: SetNull)
  subtasks Task[]  @relation("StoryChildren")

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  sprintId String?
  sprint   Sprint? @relation(fields: [sprintId], references: [id], onDelete: SetNull)

  comments    Comment[]
  attachments Attachment[]

  @@unique([projectId, number])
  @@index([projectId, sprintId])
}

model Sprint {
  id        String    @id @default(cuid())
  name      String
  goal      String    @default("")
  startDate DateTime?
  endDate   DateTime?
  createdAt DateTime  @default(now())

  state       String    @default("PLANNED") // PLANNED | ACTIVE | COMPLETED
  startedAt   DateTime?
  completedAt DateTime?

  committedPoints Int @default(0)
  committedCount  Int @default(0)
  completedPoints Int @default(0)
  completedCount  Int @default(0)

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  tasks      Task[]
  retroItems RetroItem[]

  @@index([projectId, state])
}

model Comment {
  id        String   @id @default(cuid())
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  authorId String?
  author   User?   @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([taskId, createdAt])
}

model Attachment {
  id        String   @id @default(cuid())
  filename  String
  mimeType  String
  size      Int
  data      Bytes
  createdAt DateTime @default(now())

  taskId String?
  task   Task?   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  uploadedById String?
  uploadedBy   User?   @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
}

// Notas públicas del proyecto (brief, actas de reunión, acuerdos). Las ve y
// las edita todo el equipo.
model Note {
  id        String   @id @default(cuid())
  title     String
  body      String   @default("")
  kind      String   @default("GENERAL") // BRIEF | REUNION | GENERAL
  pinned    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  authorId String?
  author   User?   @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([projectId, updatedAt])
}

// Chat por proyecto (v anterior). Ya no se usa: sus mensajes se copian al chat
// general (ChatMessage.legacyId) y la tabla se conserva hasta una release de limpieza.
model ProjectMessage {
  id        String   @id @default(cuid())
  body      String
  createdAt DateTime @default(now())

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  authorId String?
  author   User?   @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([projectId, createdAt])
}

// Daily asíncrono: una entrada por persona y día (fecha "YYYY-MM-DD").
model StandupEntry {
  id        String   @id @default(cuid())
  date      String
  yesterday String   @default("")
  today     String   @default("")
  blockers  String   @default("")
  help      String   @default("") // "¿en qué te puedo ayudar?"
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId, date])
  @@index([projectId, date])
}

// Retro de un sprint: qué funcionó, qué mejorar y acuerdos (que pueden pasar a ticket).
model RetroItem {
  id        String   @id @default(cuid())
  column    String // WENT_WELL | IMPROVE | ACTION
  body      String
  ticketKey String? // si el acuerdo ya se convirtió en ticket
  createdAt DateTime @default(now())

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  sprintId String
  sprint   Sprint @relation(fields: [sprintId], references: [id], onDelete: Cascade)

  authorId String?
  author   User?   @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([projectId, sprintId])
}

// Ayuda y contactos: quién sabe de qué / a quién llamar en cada proyecto.
model ProjectContact {
  id        String   @id @default(cuid())
  name      String
  role      String   @default("")
  contact   String   @default("")
  notes     String   @default("")
  createdAt DateTime @default(now())

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

// Suscripción de un navegador/dispositivo a las notificaciones push (PWA).
model PushSubscription {
  id        String   @id @default(cuid())
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Chat general del equipo. El texto lleva marcas [[project:id]] / [[issue:id]] /
// [[sprint:id]] / [[user:id]] que se muestran como chapitas con enlace.
model ChatMessage {
  id        String   @id @default(cuid())
  body      String
  legacyId  String?  @unique // id del ProjectMessage del que se copió
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt // cambia con reacciones y borrados (el chat se sincroniza por acá)
  deletedAt DateTime? // legacy: versión anterior hacía borrado suave; ahora se borra de verdad (ver ChatDeletion)

  // Respuesta a otro mensaje
  replyToId String?
  replyTo   ChatMessage?  @relation("ChatReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies   ChatMessage[] @relation("ChatReplies")

  authorId String?
  author   User?   @relation(fields: [authorId], references: [id], onDelete: SetNull)

  refs      ChatRef[]
  files     ChatFile[]
  reactions ChatReaction[]

  @@index([createdAt])
  @@index([updatedAt])
}

// Referencia dentro de un mensaje. projectId permite filtrar el chat por proyecto.
model ChatRef {
  id       String @id @default(cuid())
  kind     String // PROJECT | ISSUE | SPRINT | USER
  targetId String

  messageId String
  message   ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@index([projectId])
}

// Archivo adjunto de un mensaje del chat. Hoy vive en la base (ver src/lib/fileStore.ts).
model ChatFile {
  id        String   @id @default(cuid())
  filename  String
  mimeType  String
  size      Int
  data      Bytes
  createdAt DateTime @default(now())

  messageId String?
  message   ChatMessage? @relation(fields: [messageId], references: [id], onDelete: Cascade)

  uploadedById String?
  uploadedBy   User?   @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([messageId])
}

// Reacción con emoji a un mensaje (una por persona y emoji).
model ChatReaction {
  id        String   @id @default(cuid())
  emoji     String
  createdAt DateTime @default(now())

  messageId String
  message   ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
}

// Lápida de un mensaje borrado: sirve solo para avisar a los demás navegadores
// que lo quiten de la pantalla en su próximo refresco (se limpia a los pocos días).
model ChatDeletion {
  messageId String   @id
  deletedAt DateTime @default(now())

  @@index([deletedAt])
}
